<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseLaboratory>true</UseLaboratory>
        <RootNamespace>FarmingHysteresis.SmartFarming.Tests</RootNamespace>
        <AssemblyName>FarmingHysteresis.SmartFarming.Tests</AssemblyName>
        <OutputPath>../../Integrations/SmartFarming/$(RimWorldVersion)/Assemblies</OutputPath>
    </PropertyGroup>
    <!--
        Without the RimTestRedux reference (see below), this project has no Publicize items of
        its own, so Krafs.Publicizer's generated IgnoresAccessChecksToAttribute merely shadows
        the one already made public inside the referenced FarmingHysteresis.SmartFarming
        assembly; CS0436 is harmless here.
    -->
    <PropertyGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>
    <!--
        Dev-only test assembly for the Smart Farming integration, built and run in-game via
        RimTest Redux (see https://github.com/ilyvion/rimtest-redux). Its output is deployed
        alongside FarmingHysteresis.SmartFarming.dll into
        Integrations/SmartFarming/<version>/Assemblies, which LoadFolders.xml only loads when
        Smart Farming (Owlchemist.SmartFarming) is active, so these tests are only discovered
        when there's a matching install for them to actually exercise, and launching
        FarmingHysteresis without it never touches this assembly.

        It's listed in FarmingHysteresis.sln so it always builds locally (default Configuration
        is Debug, see .vscode/build_config.sh), but FarmingHysteresis.sln deliberately omits a
        Release|Any CPU.Build.0 line for this project's GUID, so a Release-configuration build
        (what CI/release always use, per rimworld-utils' build_mod.yml) skips building it
        entirely; its output never lands in a shipped release.

        RimTest Redux only supports RimWorld 1.6, so for any other RimWorldVersion this project
        builds as an empty assembly: both the test sources and the RimTestRedux reference are
        excluded below.
    -->
    <ItemGroup>
        <ProjectReference Include="..\FarmingHysteresis\FarmingHysteresis.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
        <ProjectReference Include="..\FarmingHysteresis.SmartFarming\FarmingHysteresis.SmartFarming.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
        <Reference Include="SmartFarming">
            <HintPath>$(RimWorldSteamWorkshopFolderPath)\3220129183\$(RimWorldVersion)\Assemblies\SmartFarming.dll</HintPath>
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
        <ProjectReference Include="$(ProjectDependenciesBasePath)\RimTest\Source\RimTestRedux\RimTestRedux.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <Compile Remove="**/*.cs" />
    </ItemGroup>
</Project>
